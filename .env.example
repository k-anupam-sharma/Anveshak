# Neo4j Database (Aura)
NEO4J_URI=neo4j+s://<YOUR_DB_ID>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<YOUR_PASSWORD>
NEO4J_DATABASE=neo4j

# Databricks SQL Warehouse
DATABRICKS_SERVER_HOSTNAME=<YOUR_WORKSPACE>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<YOUR_WAREHOUSE_ID>
DATABRICKS_TOKEN=<YOUR_PAT_TOKEN>

# Demo Mode Fallback
# If the above variables are left empty or commented out, the backend will automatically 
# use high-quality synthetic demo data for a robust offline presentation.
